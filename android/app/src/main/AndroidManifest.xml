<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
<!-- 必须添加：允许网络访问 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- 可选：允许访问网络状态（判断是否联网） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- 可选：允许访问WiFi状态 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <!-- GPS 定位（天气卡片） -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- 传统存储权限（Android 12及以下） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- 相机权限 -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- 媒体权限（Android 13+） -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      随身听的后台播放（audio_service / just_audio_background）：
        - WAKE_LOCK：息屏后继续放，不被 Doze 掐掉；
        - FOREGROUND_SERVICE_MEDIA_PLAYBACK：targetSdk 34+ 起，启动前台服务
          必须声明具体类型，否则 startForeground 直接抛异常（播放会立刻断）。
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!--
      ⚠️ 保持 false（= 不参与 Android 的「预测性返回」），不要改回 true。

      历史：这里曾经是 true（模板/文档都推荐"支持返回手势预览"）。但实测有设备
      反馈「用返回手势返回上一级时 App 无法交互 / 卡死」：页面从四个角向内缩，
      缩完返回上一级，有概率整个 App 点不动。那是 Flutter 的预测性返回转场
      （`PredictiveBackPageTransitionsBuilder`，本版本 Android 的默认转场）——
      框架在手势一开始就替系统认领这次手势、按手指进度自己画缩放，然后**必须**
      等到平台发 commit / cancel 才退出该状态；手势事件与路由 pop 是异步竞态，
      对不上时页面会停在缩了一半的位置且事件被 Navigator 的 AbsorbPointer 吞掉。
      按键返回走的是另一条路（`backEvent.isButtonEvent == true`，框架不认领），
      所以只有手势会中招 —— 与反馈完全一致。

      置 false 后返回统一走传统的 `onBackPressed` 路径（Flutter 处理了这条路径，
      功能不受影响，只是没有系统级的返回预览动画）。Dart 侧还有一半配套改动：
      `AppTheme._backGestureSafeTransitions()` 把 Android 页面转场显式钉在
      `FadeForwardsPageTransitionsBuilder` 上 —— 两处都要在，缺一个都还会认领手势。
    -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="false"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="ChiffonMai"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!--
          关于下面两个属性，改动原因说明（不要再改回 Flutter 模板的默认值）：

          Flutter 模板默认给的是 launchMode="singleTop" + taskAffinity=""，
          而 taskAffinity="" 表示「不属于任何任务」。文件管理器用
          ACTION_VIEW + FLAG_ACTIVITY_NEW_TASK 打开 .cmf 时，系统拿着空 affinity
          找不到已存在的任务，于是新建一个任务 → 新的 MainActivity 实例 →
          新的 FlutterEngine → 表现为「又开了一个 App」，而不是把后台那个拉到前台。

          所以：
            - 去掉 taskAffinity=""，让它回到默认 affinity（与包名一致），
              系统就能匹配到已有任务并复用（这是本次问题的根因）；
            - launchMode 用 singleTask，从系统层面保证全局只有一个实例，
              后续任何来源的启动都走 onNewIntent 投递（MainActivity 已处理）。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!--
              收藏夹文件「一键导入」入口 1：文件管理器里点开文件。
              只对下列后缀生效，避免 App 出现在所有文件的选择列表里。
              注意：部分文件管理器（走 SAF）给出的 content:// URI 不带后缀，
              pathPattern 匹配不到，这类情况请用下面的「分享」入口。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:mimeType="*/*"/>
                <data android:pathPattern=".*\\.cmf"/>
                <data android:pathPattern=".*\\.cmfavorite"/>
                <data android:pathPattern=".*\\.chiffonmai"/>
                <data android:pathPattern=".*\\.cmaifav"/>
            </intent-filter>

            <!--
              收藏夹文件「一键导入」入口 2：分享 → ChiffonMai。
              自定义后缀无法在编译期写进 pathPattern，所以这里放开成 */*，
              任何后缀的文件都能通过分享导回，由 Dart 侧按内容校验。
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
        </activity>

        <!--
          随身听的后台播放服务与媒体按键接收器（audio_service / just_audio_background）。

          三处缺一都会「能播但没有通知栏/锁屏控制」，排查时按顺序看：
            1. 这里有没有声明 AudioService；
            2. MainActivity 是不是继承了 AudioServiceActivity；
            3. 有没有 FOREGROUND_SERVICE_MEDIA_PLAYBACK 权限。
          通知栏**不显示**时还要确认 POST_NOTIFICATIONS 是否被用户拒绝。
        -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!--
          随身听的自定义通知栏（曲绘占左侧整高 + 右侧三行）。

          `foregroundServiceType="mediaPlayback"` 是必须的：Android 14+ 起启动
          前台服务要声明具体类型，否则直接抛异常（表现是通知栏不出现）。

          ⚠️ 它与上面 audio_service 的 AudioService **并存**：
          AudioService 负责播放/锁屏/耳机按键，本服务只负责画通知栏，
          并且**故意使用与 AudioService 相同的通知 ID（1124）**去顶掉它的通知，
          这样用户只看得到一条。详见 PortableNotificationService 的类注释。
        -->
        <service
            android:name=".PortableNotificationService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />


    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher 需要查询可处理网页链接的活动。部分 Android 11+ ROM
             在没有声明时会让 canLaunchUrl 出现假阴性；保留声明以兼容仍需查询
             的第三方组件和旧版本代码。 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <package android:name="tv.danmaku.bili" />  <!-- B站应用包名 -->
    </queries>
</manifest>
