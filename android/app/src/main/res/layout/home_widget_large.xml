<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <ImageView
        android:id="@+id/w_avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="10dp"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="@null" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
    android:id="@+id/w_nickname"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:ellipsize="none"
    android:includeFontPadding="false"
    android:textSize="15sp"
    android:textColor="@color/widget_ink"
    android:text="ChiffonMai"
    android:fontFamily="@font/outfit_medium"
    android:autoSizeTextType="uniform"
    android:autoSizeMinTextSize="11sp"
    android:autoSizeMaxTextSize="15sp"
    android:autoSizeStepGranularity="1sp" />

        <FrameLayout android:layout_width="1dp" android:layout_height="4dp" />
<TextView
    android:fontFamily="@font/outfit_regular"
    android:id="@+id/w_b35"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:ellipsize="none"
    android:includeFontPadding="false"
    android:textSize="11sp"
    android:textColor="@color/widget_muted"
    android:text="B35 -"
    
     />

        <TextView
    android:fontFamily="@font/outfit_regular"
    android:id="@+id/w_b15"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:ellipsize="none"
    android:includeFontPadding="false"
    android:textSize="11sp"
    android:textColor="@color/widget_muted"
    android:text="B15 -"
    
     />

    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:orientation="vertical">
        <TextView
    android:id="@+id/w_rating_title"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:ellipsize="none"
    android:includeFontPadding="false"
    android:textSize="11sp"
    android:textColor="@color/widget_muted"
    android:text="Rating"
    android:fontFamily="@font/outfit_medium"
     />

        <TextView
    android:id="@+id/w_rating"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:ellipsize="none"
    android:includeFontPadding="false"
    android:textSize="36sp"
    android:textColor="@color/widget_primary"
    android:text="--"
    android:fontFamily="@font/outfit_bold"
     />

    </LinearLayout>
</LinearLayout>
<FrameLayout android:layout_width="1dp" android:layout_height="8dp" />
<ProgressBar
    android:id="@+id/w_rating_bar"
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent"
    android:layout_height="6dp"
    android:max="100"
    android:progress="70"
    android:progressDrawable="@drawable/widget_progress" />
<FrameLayout android:layout_width="1dp" android:layout_height="8dp" />
<LinearLayout
    android:id="@+id/w_server_area"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_inset_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">
    <ImageView
        android:id="@+id/w_server_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/widget_dot"
        android:contentDescription="@null" />
    <TextView
    android:id="@+id/w_server"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:ellipsize="none"
    android:includeFontPadding="false"
    android:textSize="14sp"
    android:textColor="@color/widget_ink"
    android:text="@string/native_text_58"
    android:fontFamily="@font/outfit_medium"
     />

    <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
    <TextView
    android:fontFamily="@font/outfit_regular"
    android:id="@+id/w_server_detail"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:ellipsize="none"
    android:includeFontPadding="false"
    android:textSize="12sp"
    android:textColor="@color/widget_muted"
    android:text=""
    
     />

</LinearLayout>
<FrameLayout android:layout_width="1dp" android:layout_height="6dp" />
<LinearLayout
    android:id="@+id/w_sync_area"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:background="@drawable/widget_inset_bg"
    android:orientation="vertical"
    android:padding="10dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
    android:id="@+id/w_sync_title"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:ellipsize="none"
    android:includeFontPadding="false"
    android:textSize="12sp"
    android:textColor="@color/widget_ink"
    android:text="@string/native_text_72"
    android:fontFamily="@font/outfit_medium"
     />

        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView
    android:fontFamily="@font/outfit_regular"
    android:id="@+id/w_sync_time"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:ellipsize="none"
    android:includeFontPadding="false"
    android:textSize="12sp"
    android:textColor="@color/widget_muted"
    android:text=""
    
     />

    </LinearLayout>
    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <ImageView
        android:id="@+id/w_src1_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/widget_dot"
        android:contentDescription="@null" />
    <TextView
    android:fontFamily="@font/outfit_regular"
    android:id="@+id/w_src1_name"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:ellipsize="none"
    android:includeFontPadding="false"
    android:textSize="13sp"
    android:textColor="@color/widget_ink"
    android:text="-"
    
     />

    <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
    <TextView
    android:id="@+id/w_src1_value"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:ellipsize="none"
    android:includeFontPadding="false"
    android:textSize="13sp"
    android:textColor="@color/widget_ink"
    android:text="-"
    android:fontFamily="@font/outfit_medium"
     />

</LinearLayout>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <ImageView
        android:id="@+id/w_src2_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/widget_dot"
        android:contentDescription="@null" />
    <TextView
    android:fontFamily="@font/outfit_regular"
    android:id="@+id/w_src2_name"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:ellipsize="none"
    android:includeFontPadding="false"
    android:textSize="13sp"
    android:textColor="@color/widget_ink"
    android:text="-"
    
     />

    <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
    <TextView
    android:id="@+id/w_src2_value"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:ellipsize="none"
    android:includeFontPadding="false"
    android:textSize="13sp"
    android:textColor="@color/widget_ink"
    android:text="-"
    android:fontFamily="@font/outfit_medium"
     />

</LinearLayout>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <ImageView
        android:id="@+id/w_src3_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/widget_dot"
        android:contentDescription="@null" />
    <TextView
    android:fontFamily="@font/outfit_regular"
    android:id="@+id/w_src3_name"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:ellipsize="none"
    android:includeFontPadding="false"
    android:textSize="13sp"
    android:textColor="@color/widget_ink"
    android:text="-"
    
     />

    <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
    <TextView
    android:id="@+id/w_src3_value"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:ellipsize="none"
    android:includeFontPadding="false"
    android:textSize="13sp"
    android:textColor="@color/widget_ink"
    android:text="-"
    android:fontFamily="@font/outfit_medium"
     />

</LinearLayout>

</LinearLayout>
<FrameLayout android:layout_width="1dp" android:layout_height="6dp" />
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">
    <TextView
    android:id="@+id/w_btn_sync"
    android:layout_width="0dp"
    android:layout_height="44dp"
    android:layout_weight="1"
    android:background="@drawable/widget_btn_primary"
    android:fontFamily="@font/outfit_medium"
    android:gravity="center"
    android:text="@string/native_text_73"
    android:textColor="@color/widget_on_primary"
    android:textSize="13sp" />

    <FrameLayout android:layout_width="6dp" android:layout_height="1dp" />
    <TextView
    android:id="@+id/w_btn_ocr"
    android:layout_width="0dp"
    android:layout_height="44dp"
    android:layout_weight="1"
    android:background="@drawable/widget_inset_bg"
    android:fontFamily="@font/outfit_medium"
    android:gravity="center"
    android:text="@string/native_text_74"
    android:textColor="@color/widget_ink"
    android:textSize="13sp" />

    <FrameLayout android:layout_width="6dp" android:layout_height="1dp" />
    <TextView
    android:id="@+id/w_btn_player"
    android:layout_width="0dp"
    android:layout_height="44dp"
    android:layout_weight="1"
    android:background="@drawable/widget_inset_bg"
    android:fontFamily="@font/outfit_medium"
    android:gravity="center"
    android:text="@string/native_text_68"
    android:textColor="@color/widget_ink"
    android:textSize="13sp" />

</LinearLayout>
</LinearLayout>
