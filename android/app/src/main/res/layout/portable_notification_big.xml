<?xml version="1.0" encoding="utf-8"?>
<!--
  随身听通知的展开态：大曲绘 + 状态 / 曲名 / 艺术家 + 控制条。

  收起态见 portable_notification.xml。限制与颜色约定也和它一样：只能用 RemoteViews
  支持的控件，颜色一律走 @color。曲绘尺寸改动要同步 PortableNotificationService.BIG_ART_DP。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/portable_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="4dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/portable_art"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:layout_marginEnd="14dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/portable_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:textColor="@color/portable_accent" />

        <TextView
            android:id="@+id/portable_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:textColor="@color/portable_title" />

        <TextView
            android:id="@+id/portable_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="12.5sp"
            android:includeFontPadding="false"
            android:textColor="@color/portable_subtitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/portable_prev"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/portable_ic_prev"
                android:contentDescription="上一首" />

            <ImageView
                android:id="@+id/portable_play"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/portable_ic_play"
                android:contentDescription="播放/暂停" />

            <ImageView
                android:id="@+id/portable_next"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="14dp"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/portable_ic_next"
                android:contentDescription="下一首" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
